{
  "uid": "application-logs",
  "title": "Centralized Application Logs",
  "tags": [
    "logging",
    "loki",
    "microservices"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Log Volume",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "eg4gv78cjmdc0e"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"application\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "Total Logs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Logs by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "eg4gv78cjmdc0e"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({job=\"application\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Logs by Severity",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "eg4gv78cjmdc0e"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=\"application\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "Level {{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent Application Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "eg4gv78cjmdc0e"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "{job=\"application\", service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Error Log Trends",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "eg4gv78cjmdc0e"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({job=\"application\", level=\"50\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "eg4gv78cjmdc0e"
        },
        "definition": "label_values({job=\"application\"}, service)",
        "query": {
          "label": "service",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"application\"}",
          "type": 1
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  }
}